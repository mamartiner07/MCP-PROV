# Token JWT Bearer para autorizar las peticiones a la API de Provident
PROVIDENT_BEARER_TOKEN=tu_token_jwt_aqui

# Endpoints base de las APIs
PROVIDENT_BASE_URL=https://api.supporttsmx.com.mx
PROVIDENT_AD_URL=https://api.supporttsmx.com.mx:6443

# Credenciales y servidor de Active Directory
AD_DEFAULT_USER=chatbot.connect
AD_DEFAULT_PSW=tu_contraseña_ad_en_base64
AD_DEFAULT_SERVER=ADProviTest01.ProvidentMX.Test

# Configuración del servidor MCP HTTP (Compatible con Copilot Studio)
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp

# Configuración de red
HTTP_TIMEOUT=120.0
VERIFY_SSL=true

# Clave de autenticación para Copilot Studio / clientes HTTP (Header: X-API-Key)
MCP_API_KEY=tu_clave_secreta_aqui

# Configuración ChatBridge SMS (Envío de contraseñas)
CHATBRIDGE_API_KEY=tu_api_key_chatbridge_aqui
CHATBRIDGE_SMS_URL=https://connect.chatbridge.mx/v1/sms/messages
CHATBRIDGE_SMS_MASK=6aac0ecdb99ccfcfa56bbc2d

# Configuración ServiceNow (Documentación y Cierre de Tickets)
PROVIDENT_SNOW_URL=https://api.supporttsmx.com.mx:8443
SNOW_DEFAULT_REQUESTOR=0e966fba838ff6d063a134326daad374
SNOW_BUSINESS_SERVICE=0f873c450f5802003e6c85ece1050e4f
SNOW_ASSIGNMENT_GROUP=64bb9f64378fe200d8a8579543990eee
SNOW_MANAGER_FALLBACK=d8423b640fd402003e6c85ece1050e1e
SNOW_PRIORITY=4
SNOW_CATEGORY=Active Directory

